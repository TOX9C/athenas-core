{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athena's Core",
  "version": "0.1.0",
  "identifier": "com.athena.app",
  "build": {
    "beforeDevCommand": "bash frontend/build-dist.sh --debug",
    "beforeBuildCommand": "bash frontend/build-dist.sh",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Athena's Core",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self'; connect-src 'self'; font-src 'self'; media-src 'self'; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {}
}
