{
  "name": "athenas-core",
  "productName": "Athena's Core",
  "version": "3.3.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mcp": "npm test --workspace=packages/mcp-server",
    "check:tauri-commands": "node scripts/check-tauri-command-drift.mjs",
    "check:tauri-permissions": "node scripts/check-tauri-permission-drift.mjs",
    "check:plugin-integration": "node scripts/check-plugin-integration.mjs",
    "check:tauri-security": "node scripts/check-tauri-security-config.mjs",
    "check:release-privacy": "node scripts/check-release-privacy.mjs",
    "check:release-identity": "node scripts/check-release-identity.mjs",
    "verify:macos-artifact": "node scripts/verify-macos-artifact.mjs",
    "check:macos-release": "node scripts/run-macos-release-checks.mjs",
    "test:release-scripts": "node scripts/test-verify-macos-artifact.mjs && node scripts/test-frontend-watchdog.mjs && node scripts/check-tauri-security-config.mjs && node scripts/check-release-privacy.mjs && node scripts/check-release-identity.mjs && node scripts/test-release-identity.mjs",
    "check:clippy-baseline": "node scripts/run-clippy-baseline.mjs",
    "test:e2e": "cd e2e-tests && npm test",
    "lint": "eslint tests packages plugins --ext .ts,.tsx",
    "lint:fix": "eslint tests packages plugins --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@wdio/cli": "^9.27.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.8.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
